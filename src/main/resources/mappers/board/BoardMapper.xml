<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.naranghiking.board.dao.BoardDao">

    <resultMap id="boardResponseMap" type="BoardResponse">
        <result column="user_id" property="userId"/>
        <result column="track_id" property="trackId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectAll" resultMap="boardResponseMap">
        SELECT user_id, track_id, title, content, category, created_at
          FROM boards
    </select>
</mapper>