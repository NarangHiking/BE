<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.naranghiking.user.dao.UserDao">

    <select id="selectAll">
        select * from users;
    </select>

    <select id="select">
        select * from users
        where email = #{email};
    </select>

    <insert id="insert">
        insert into users(email, pass, name, role)
        values (#{email}, #{pass}, #{name}, #{role})
    </insert>

    <update id="update">
        update users
        set email = #{email},
            pass = #{email},
            name = #{name},
            role = #{role}
        where id = #{id}
    </update>

    <delete id="delete">
        delete from users
        where id = #{id}
    </delete>

</mapper>